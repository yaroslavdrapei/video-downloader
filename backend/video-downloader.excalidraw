      "text": "IDownloader {\n    // get lib-specific formats and match them to the universal formats\n    getInfo(link: string) -> Format[]\n\n    // download for a single format (just audio or video)\n    basicDownload(link: string, formatId: string) -> Readable\n\n    // when video is without sound, merge it with audio\n    mergeDownload(link: string, formats: MergeFormats) -> Readable\n}\n\ntype MergeFormatIds = {\n    videoFormatId: string;\n    audioFormatId: string;\n} \n\n// service for building command of ytdlpwrap\nYtdlpCliService ?",
      "fontSize": 28,

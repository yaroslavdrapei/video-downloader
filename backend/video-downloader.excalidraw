    {
      "id": "tqjy3OZtbS6hhnMe7VqAZ",
      "type": "text",
      "x": 5214.736845208218,
      "y": -1189.8421559318908,
      "width": 791.7871704101562,
      "height": 980,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Q",
      "roundness": null,
      "seed": 1096442832,
      "version": 1753,
      "versionNonce": 2050042672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1755434498853,
      "link": null,
      "locked": false,
      "text": "enum CookieStatus {\n    USABLE // freely use them for request\n    RETRIEVING // currently being retrieved\n    EXPIRED // couldn't be retrieved and are unusable\n}\n\ntype Cookie {\n    status: CookieStatus,\n    data: unknown // cookies themselves\n}\n\nthis cookie object will be stored in redis for\nreuse on different requests\n\nRETRIEVING status is needed to avoid a situation\nwhere two or more requests are trying to fetch cookies\nat the same time \n\nICookieService {\n    // get brand-new cookies from website and cache them\n    fetch()\n\n    //  return cached cookies\n    get()\n\n    // set cookies status to expired\n    expire()\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "enum CookieStatus {\n    USABLE // freely use them for request\n    RETRIEVING // currently being retrieved\n    EXPIRED // couldn't be retrieved and are unusable\n}\n\ntype Cookie {\n    status: CookieStatus,\n    data: unknown // cookies themselves\n}\n\nthis cookie object will be stored in redis for\nreuse on different requests\n\nRETRIEVING status is needed to avoid a situation\nwhere two or more requests are trying to fetch cookies\nat the same time \n\nICookieService {\n    // get brand-new cookies from website and cache them\n    fetch()\n\n    //  return cached cookies\n    get()\n\n    // set cookies status to expired\n    expire()\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },

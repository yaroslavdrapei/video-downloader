    {
      "id": "rSXzaFxk9dXruTcl2HBVK",
      "type": "text",
      "x": 4092.3323694832106,
      "y": -1657.713628617688,
      "width": 962.0838012695312,
      "height": 910,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1589516240,
      "version": 811,
      "versionNonce": 1209759024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1755434634775,
      "link": null,
      "locked": false,
      "text": "enum Platforms {\n    YOUTUBE,\n    TIKTOK,\n    INSTAGRAM\n}\n\nIPlatform {\n    // return info about the video\n    getInfo(link: string) -> Info\n    \n    // self-explainatory\n    download(link: string, formatId: string) -> Readable\n}\n\nYoutubePlatformService :   IPlatform\nTiktokPlatformService :    IPlatform\nInstagramPlatformService: IPlatform\n\nPlatformFactory {\n    // return the right service, otherwise error not supported platform\n    create(link: string) -> IPlatform\n\n    // return the platform or throw error is link is invalid\n    private match(link: string) -> Platforms\n}\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "enum Platforms {\n    YOUTUBE,\n    TIKTOK,\n    INSTAGRAM\n}\n\nIPlatform {\n    // return info about the video\n    getInfo(link: string) -> Info\n    \n    // self-explainatory\n    download(link: string, formatId: string) -> Readable\n}\n\nYoutubePlatformService :   IPlatform\nTiktokPlatformService :    IPlatform\nInstagramPlatformService: IPlatform\n\nPlatformFactory {\n    // return the right service, otherwise error not supported platform\n    create(link: string) -> IPlatform\n\n    // return the platform or throw error is link is invalid\n    private match(link: string) -> Platforms\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
